msgid "Modern and robust statistical tests using the rstatix package. Includes Welch ANOVA, ANCOVA, and outlier diagnostics."
msgstr "Testes estatísticos modernos e robustos usando o pacote rstatix. Inclui ANOVA de Welch, ANCOVA e diagnóstico de valores atípicos."

msgid "Robust ANOVA (Welch & Games-Howell)"
msgstr "ANOVA Robusta (Welch e Games-Howell)"

msgid "Computes a Welch one-way ANOVA (does not assume equal variances) and the Games-Howell post-hoc test using rstatix."
msgstr "Calcula uma ANOVA de Welch de um fator (não assume variâncias iguais) e o teste post-hoc de Games-Howell usando rstatix."

msgid "Data frame"
msgstr "Data frame"

msgid "Dependent Variable (Numeric)"
msgstr "Variável Dependente (Numérica)"

msgid "Grouping Variable (Factor)"
msgstr "Variável de Agrupamento (Fator)"

msgid "Calculate Effect Size (Eta Squared)"
msgstr "Calcular Tamanho do Efeito (Eta Quadrado)"

msgid "Compute Games-Howell Post-hoc Test"
msgstr "Calcular Teste Post-hoc de Games-Howell"

msgid "Save post-hoc results as"
msgstr "Salvar resultados post-hoc como"

msgid "Data"
msgstr "Dados"

msgid "Options"
msgstr "Opções"

msgid "Robust ANOVA (Welch)"
msgstr "ANOVA Robusta (Welch)"

msgid "<b>Test:</b> Welch One-Way ANOVA (Unequal variances assumed)"
msgstr "<b>Teste:</b> ANOVA de Welch de um fator (Assume variâncias desiguais)"

msgid "Effect Size (Eta Squared)"
msgstr "Tamanho do Efeito (Eta Quadrado)"

msgid "Games-Howell Post-hoc Test"
msgstr "Teste Post-hoc de Games-Howell"

msgid "<i>Post-hoc results saved to workspace as: </i><code>"
msgstr "<i>Resultados post-hoc salvos no workspace como: </i><code>"

msgid "ANCOVA (Analysis of Covariance)"
msgstr "ANCOVA (Análise de Covariância)"

msgid "Computes ANCOVA and estimated marginal means (EMMeans) adjusting for covariates using rstatix."
msgstr "Calcula ANCOVA e médias marginais estimadas (EMMeans) ajustando por covariáveis usando rstatix."

msgid "Covariate(s) (Numeric)"
msgstr "Covariável(is) (Numérica)"

msgid "Calculate Estimated Marginal Means (EMMeans)"
msgstr "Calcular Médias Marginais Estimadas (EMMeans)"

msgid "Perform pairwise comparisons for EMMeans (Bonferroni adjusted)"
msgstr "Realizar comparações pareadas para EMMeans (Ajuste de Bonferroni)"

msgid "ANCOVA"
msgstr "ANCOVA"

msgid "Data Definition"
msgstr "Definição de Dados"

msgid "Post-hoc & EMMeans"
msgstr "Post-hoc e EMMeans"

msgid "Analysis of Covariance (ANCOVA)"
msgstr "Análise de Covariância (ANCOVA)"

msgid "Estimated Marginal Means (Adjusted for Covariates)"
msgstr "Médias Marginais Estimadas (Ajustadas por Covariáveis)"

msgid "Pairwise Comparisons (Bonferroni)"
msgstr "Comparações Pareadas (Bonferroni)"

msgid "Identify Outliers"
msgstr "Identificar Valores Atípicos (Outliers)"

msgid "Quickly filters and identifies univariate outliers (and extreme outliers) per group using rstatix."
msgstr "Filtra e identifica rapidamente valores atípicos univariados (e extremos) por grupo usando rstatix."

msgid "Target Variable (Numeric)"
msgstr "Variável Alvo (Numérica)"

msgid "Grouping Variable (Optional)"
msgstr "Variável de Agrupamento (Opcional)"

msgid "Show ONLY Extreme Outliers (values beyond 3x IQR)"
msgstr "Mostrar APENAS Valores Atípicos Extremos (valores além de 3x o IIQ)"

msgid "Filtering"
msgstr "Filtragem"

msgid "Outliers Diagnostics"
msgstr "Diagnóstico de Valores Atípicos"

msgid "<b>Criterion: </b>"
msgstr "<b>Critério: </b>"

msgid "EXTREME Outliers Only (3x IQR)"
msgstr "Apenas Valores Atípicos EXTREMOS (3x IIQ)"

msgid "All Outliers (1.5x IQR)"
msgstr "Todos os Valores Atípicos (1.5x IIQ)"

msgid "<i>No outliers found in the dataset under the selected criteria.</i>"
msgstr "<i>Nenhum valor atípico encontrado no conjunto de dados sob os critérios selecionados.</i>"

msgid "Psychology / Social Science"
msgstr "Psicologia / Ciências Sociais"

msgid "Frequentist"
msgstr "Frequentista"

msgid "Save all results as (List)"
msgstr "Salvar todos os resultados como (Lista)"

msgid "<i>All generated results saved to workspace as a list: </i><code>"
msgstr "<i>Todos os resultados gerados foram salvos no workspace como uma lista: </i><code>"
