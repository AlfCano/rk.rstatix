msgid "Modern and robust statistical tests using the rstatix package. Includes Welch ANOVA, ANCOVA, and outlier diagnostics."
msgstr "Pruebas estadísticas modernas y robustas usando el paquete rstatix. Incluye ANOVA de Welch, ANCOVA y diagnóstico de valores atípicos."

msgid "Robust ANOVA (Welch & Games-Howell)"
msgstr "ANOVA Robusto (Welch y Games-Howell)"

msgid "Computes a Welch one-way ANOVA (does not assume equal variances) and the Games-Howell post-hoc test using rstatix."
msgstr "Calcula un ANOVA de Welch de una vía (no asume varianzas iguales) y la prueba post-hoc de Games-Howell usando rstatix."

msgid "Data frame"
msgstr "Data frame"

msgid "Dependent Variable (Numeric)"
msgstr "Variable Dependiente (Numérica)"

msgid "Grouping Variable (Factor)"
msgstr "Variable de Agrupación (Factor)"

msgid "Calculate Effect Size (Eta Squared)"
msgstr "Calcular Tamaño del Efecto (Eta Cuadrada)"

msgid "Compute Games-Howell Post-hoc Test"
msgstr "Calcular Prueba Post-hoc de Games-Howell"

msgid "Save post-hoc results as"
msgstr "Guardar resultados post-hoc como"

msgid "Data"
msgstr "Datos"

msgid "Options"
msgstr "Opciones"

msgid "Robust ANOVA (Welch)"
msgstr "ANOVA Robusto (Welch)"

msgid "<b>Test:</b> Welch One-Way ANOVA (Unequal variances assumed)"
msgstr "<b>Prueba:</b> ANOVA de Welch de una vía (Asume varianzas desiguales)"

msgid "Effect Size (Eta Squared)"
msgstr "Tamaño del Efecto (Eta Cuadrada)"

msgid "Games-Howell Post-hoc Test"
msgstr "Prueba Post-hoc de Games-Howell"

msgid "<i>Post-hoc results saved to workspace as: </i><code>"
msgstr "<i>Resultados post-hoc guardados en el entorno como: </i><code>"

msgid "ANCOVA (Analysis of Covariance)"
msgstr "ANCOVA (Análisis de Covarianza)"

msgid "Computes ANCOVA and estimated marginal means (EMMeans) adjusting for covariates using rstatix."
msgstr "Calcula ANCOVA y medias marginales estimadas (EMMeans) ajustando por covariables usando rstatix."

msgid "Covariate(s) (Numeric)"
msgstr "Covariable(s) (Numérica)"

msgid "Calculate Estimated Marginal Means (EMMeans)"
msgstr "Calcular Medias Marginales Estimadas (EMMeans)"

msgid "Perform pairwise comparisons for EMMeans (Bonferroni adjusted)"
msgstr "Realizar comparaciones por pares para EMMeans (Ajuste de Bonferroni)"

msgid "ANCOVA"
msgstr "ANCOVA"

msgid "Data Definition"
msgstr "Definición de Datos"

msgid "Post-hoc & EMMeans"
msgstr "Post-hoc y EMMeans"

msgid "Analysis of Covariance (ANCOVA)"
msgstr "Análisis de Covarianza (ANCOVA)"

msgid "Estimated Marginal Means (Adjusted for Covariates)"
msgstr "Medias Marginales Estimadas (Ajustadas por Covariables)"

msgid "Pairwise Comparisons (Bonferroni)"
msgstr "Comparaciones por pares (Bonferroni)"

msgid "Identify Outliers"
msgstr "Identificar Valores Atípicos (Outliers)"

msgid "Quickly filters and identifies univariate outliers (and extreme outliers) per group using rstatix."
msgstr "Filtra e identifica rápidamente valores atípicos univariados (y extremos) por grupo usando rstatix."

msgid "Target Variable (Numeric)"
msgstr "Variable Objetivo (Numérica)"

msgid "Grouping Variable (Optional)"
msgstr "Variable de Agrupación (Opcional)"

msgid "Show ONLY Extreme Outliers (values beyond 3x IQR)"
msgstr "Mostrar SOLO Valores Atípicos Extremos (valores más allá de 3x IQR)"

msgid "Filtering"
msgstr "Filtrado"

msgid "Outliers Diagnostics"
msgstr "Diagnóstico de Valores Atípicos"

msgid "<b>Criterion: </b>"
msgstr "<b>Criterio: </b>"

msgid "EXTREME Outliers Only (3x IQR)"
msgstr "Solo Valores Atípicos EXTREMOS (3x IQR)"

msgid "All Outliers (1.5x IQR)"
msgstr "Todos los Valores Atípicos (1.5x IQR)"

msgid "<i>No outliers found in the dataset under the selected criteria.</i>"
msgstr "<i>No se encontraron valores atípicos en el conjunto de datos bajo los criterios seleccionados.</i>"

msgid "Psychology / Social Science"
msgstr "Psicología / Ciencias Sociales"

msgid "Frequentist"
msgstr "Frecuentista"

msgid "Save all results as (List)"
msgstr "Guardar todos los resultados como (Lista)"

msgid "<i>All generated results saved to workspace as a list: </i><code>"
msgstr "<i>Todos los resultados generados se guardaron en el entorno como lista: </i><code>"
